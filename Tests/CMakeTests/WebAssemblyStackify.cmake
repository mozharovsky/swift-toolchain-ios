# The check compiles checked multiplications with an llc built from the patched LLVM source. An
# unpatched LLVM pushes an original operand before the wide multiply and compares it with the sign
# of the low half, so the overflow check fails for ordinary products.
if(NOT EXISTS "${TOOLCHAIN_TEST_LLC}" OR NOT DEFINED TOOLCHAIN_TEST_ROOT)
  message(FATAL_ERROR "Set TOOLCHAIN_TEST_LLC to an llc built from the patched LLVM source.")
endif()
set(fixture "${TOOLCHAIN_SOURCE_DIR}/Tests/CodegenTests/CheckedMultiply.ll")
set(output "${TOOLCHAIN_TEST_ROOT}/CheckedMultiply.s")
file(MAKE_DIRECTORY "${TOOLCHAIN_TEST_ROOT}")
execute_process(COMMAND "${TOOLCHAIN_TEST_LLC}" -O2 -mattr=+wide-arithmetic "${fixture}"
  -o "${output}" COMMAND_ERROR_IS_FATAL ANY)
file(STRINGS "${output}" lines)

# Each wide multiply must consume exactly its two operands and store both results in locals.
foreach(function signed_product unsigned_product)
  set(in_function FALSE)
  set(pushes 0)
  set(after "")
  set(found FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^${function}:")
      set(in_function TRUE)
    elseif(in_function AND line MATCHES "^\tend_function")
      break()
    elseif(in_function AND line MATCHES "^\t([a-z0-9_.]+)")
      set(instruction "${CMAKE_MATCH_1}")
      if(found)
        list(LENGTH after count)
        if(count LESS 2)
          list(APPEND after "${instruction}")
        endif()
      elseif(instruction MATCHES "^i64\\.mul_wide_[su]$")
        set(found TRUE)
      elseif(instruction MATCHES "^(local\\.get|i64\\.const)$")
        math(EXPR pushes "${pushes} + 1")
      endif()
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "${function} does not use a wide multiply. Check the target feature.")
  endif()
  if(NOT pushes EQUAL 2 OR NOT after STREQUAL "local.set;local.set")
    message(FATAL_ERROR "${function} stackifies a wide multiply result: ${pushes} pushes, then ${after}.")
  endif()
endforeach()
message(STATUS "Both wide multiplies keep their results in locals.")
