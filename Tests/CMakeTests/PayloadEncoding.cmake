include("${TOOLCHAIN_SOURCE_DIR}/CMake/PayloadCodec.cmake")
if(ENCODE_ONLY)
  toolchain_encode_payload(records "${CASE_ROOT}" "${CASE_CODEC}")
  return()
endif()
if(MAP_ONLY)
  toolchain_encoded_payload_path(encoded "${CASE_PATH}")
  return()
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef identity)
set(root "${TOOLCHAIN_TEST_ROOT}/${identity}")
file(MAKE_DIRECTORY "${root}")

# The fixture codec starts no Swift build. Its prefix keeps the archive signature out of the output.
set(codec "${root}/codec")
file(WRITE "${codec}" "#!/bin/sh\n[ \"$1\" = payload-codec ] && [ \"$2\" = compress ] || exit 2\n"
  "{ printf 'encoded:'; cat \"$3\"; } > \"$4\"\n")
file(CHMOD "${codec}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)

function(expect_mapping path expected)
  toolchain_encoded_payload_path(actual "${path}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "The encoded path of ${path} is ${actual} instead of ${expected}.")
  endif()
endfunction()
expect_mapping("lib/libc.a" "lib/libc.compilerdata")
expect_mapping("wasi/Swift.swiftmodule/wasm32.swiftmodule" "wasi/Swift.swiftmodule/wasm32.compilerdata")
expect_mapping("lib.a.a" "lib.a.compilerdata")

# Failing inputs run in another CMake process because packaging stops at the first error.
function(expect_failure name expected_message)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DTOOLCHAIN_SOURCE_DIR=${TOOLCHAIN_SOURCE_DIR}"
    ${ARGN} -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected_message}")
    message(FATAL_ERROR "The ${name} case returned ${status}. ${output} ${error}")
  endif()
endfunction()
expect_failure(shared-object "only serialized modules and static archives" -DMAP_ONLY=ON
  "-DCASE_PATH=lib/libc.so")
expect_failure(hidden-name "only serialized modules and static archives" -DMAP_ONLY=ON
  "-DCASE_PATH=lib/.a")

set(payload "${root}/payload")
file(WRITE "${payload}/lib/libc.a" "!<arch>\nmember bytes\n")
file(WRITE "${payload}/lib/empty.a" "!<arch>\n")
file(WRITE "${payload}/lib/Swift.swiftmodule/wasm32.swiftmodule" "serialized module\n")
file(WRITE "${payload}/lib/notes.txt" "notice\n")
set(expected_paths lib/Swift.swiftmodule/wasm32.swiftmodule lib/empty.a lib/libc.a)
set(expected_checksums "")
set(expected_sizes "")
foreach(path IN LISTS expected_paths)
  file(SHA256 "${payload}/${path}" checksum)
  file(SIZE "${payload}/${path}" size)
  list(APPEND expected_checksums "${checksum}")
  list(APPEND expected_sizes "${size}")
endforeach()
toolchain_encode_payload(records "${payload}" "${codec}")
string(JSON count LENGTH "${records}")
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Encoding recorded ${count} files instead of 3. ${records}")
endif()
foreach(index RANGE 2)
  list(GET expected_paths ${index} expected_path)
  list(GET expected_checksums ${index} expected_checksum)
  list(GET expected_sizes ${index} expected_size)
  toolchain_encoded_payload_path(expected_encoded "${expected_path}")
  string(JSON path GET "${records}" ${index} path)
  string(JSON encoded GET "${records}" ${index} encodedPath)
  string(JSON checksum GET "${records}" ${index} sha256)
  string(JSON size GET "${records}" ${index} decodedByteCount)
  if(NOT path STREQUAL expected_path OR NOT encoded STREQUAL expected_encoded
      OR NOT checksum STREQUAL expected_checksum OR NOT size EQUAL expected_size)
    message(FATAL_ERROR "Record ${index} does not describe ${expected_path}. ${records}")
  endif()
  if(EXISTS "${payload}/${path}" OR NOT EXISTS "${payload}/${encoded}")
    message(FATAL_ERROR "Encoding left ${path} in place of ${encoded}.")
  endif()
endforeach()
if(NOT EXISTS "${payload}/lib/notes.txt")
  message(FATAL_ERROR "Encoding removed a file that it does not record.")
endif()
toolchain_find_static_archives(archives "${payload}")
if(NOT archives STREQUAL "")
  message(FATAL_ERROR "An encoded payload still lists static archives: ${archives}.")
endif()

# Encoded names that collide, including those that differ only in case, must not replace each other.
function(expect_collision name)
  set(case_root "${root}/${name}")
  foreach(file IN LISTS ARGN)
    file(WRITE "${case_root}/${file}" "!<arch>\n")
  endforeach()
  expect_failure(${name} "already uses" -DENCODE_ONLY=ON "-DCASE_ROOT=${case_root}"
    "-DCASE_CODEC=${codec}")
endfunction()
expect_collision(module-and-archive X.a X.swiftmodule)
expect_collision(case-only x.a X.swiftmodule)
expect_collision(existing-output X.a X.compilerdata)
expect_collision(existing-output-case x.a X.compilerdata)
expect_collision(existing-directory X.a X.compilerdata/member)

# Detection follows both the file name and the ar signature of regular and thin archives.
set(scan "${root}/scan")
file(WRITE "${scan}/named.a" "text\n")
file(WRITE "${scan}/upper.A" "text\n")
file(WRITE "${scan}/nested/regular.compilerdata" "!<arch>\nmember\n")
file(WRITE "${scan}/thin.data" "!<thin>\nmember\n")
file(WRITE "${scan}/plain.txt" "!<arc\n")
file(WRITE "${scan}/empty" "")
toolchain_find_static_archives(archives "${scan}")
if(NOT archives STREQUAL "named.a;nested/regular.compilerdata;thin.data;upper.A")
  message(FATAL_ERROR "Static archive detection returned ${archives}.")
endif()
