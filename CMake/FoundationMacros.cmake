# Macro preparation and packaging expect the same copied upstream files in the macro receipt.
function(toolchain_foundation_macro_sources output)
  file(GLOB inputs "${TOOLCHAIN_FOUNDATION_SOURCE}/Sources/FoundationMacros/*.swift")
  list(SORT inputs)
  set(sources "")
  foreach(input IN LISTS inputs)
    get_filename_component(filename "${input}" NAME)
    list(APPEND sources "Source/FoundationMacros/${filename}")
  endforeach()
  if(NOT sources)
    message(FATAL_ERROR "The swift-foundation source contains no Foundation macro sources.")
  endif()
  set(${output} "${sources}" PARENT_SCOPE)
endfunction()
